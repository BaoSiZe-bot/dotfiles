{"name":"abalonecode","settings":"{\"settings\":\"{\\n    \\\"editor.fontFamily\\\": \\\"'LXGWWenKaiMono Nerd Font' ,'Droid Sans Mono', 'monospace', monospace\\\",\\n    \\\"editor.fontSize\\\": 24,\\n    \\\"workbench.colorTheme\\\": \\\"Catppuccin Frappé\\\",\\n    \\\"workbench.iconTheme\\\": \\\"catppuccin-frappe\\\",\\n    \\\"catppuccin.accentColor\\\": \\\"mauve\\\",\\n    \\\"workbench.productIconTheme\\\": \\\"jetbrains-idea-product-icon-theme\\\",\\n    \\\"workbench.sideBar.location\\\": \\\"right\\\",\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n    \\\"powermode.combo.location\\\": \\\"editor\\\",\\n    \\\"powermode.combo.counterEnabled\\\": \\\"show\\\",\\n    \\\"notebook.stickyScroll.enabled\\\": true,\\n    \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n    \\\"workbench.list.smoothScrolling\\\": true,\\n    \\\"editor.smoothScrolling\\\": true,\\n    \\\"terminal.integrated.smoothScrolling\\\": true,\\n    \\\"editor.inlineSuggest.syntaxHighlightingEnabled\\\": true,\\n    \\\"editor.inlineSuggest.suppressSuggestions\\\": true,\\n    \\\"editor.bracketPairColorization.independentColorPoolPerBracketType\\\": true,\\n    \\\"editor.experimental.treeSitterTelemetry\\\": true,\\n    \\\"editor.experimentalEditContextEnabled\\\": true,\\n    \\\"editor.mouseWheelZoom\\\": true,\\n    \\\"editor.formatOnPaste\\\": true,\\n    \\\"editor.formatOnType\\\": true,\\n    \\\"editor.minimap.autohide\\\": true,\\n    \\\"workbench.editorAssociations\\\": {\\n        \\\"{git,gitlens,git-graph}:/**/*.{md,csv,svg}\\\": \\\"default\\\",\\n        \\\"*.md\\\": \\\"default\\\",\\n        \\\"*.pdf\\\": \\\"cweijan.officeViewer\\\"\\n    },\\n    \\\"vim.easymotion\\\": true,\\n    \\\"vim.incsearch\\\": true,\\n    \\\"vim.autoindent\\\": true,\\n    \\\"vim.camelCaseMotion.enable\\\": true,\\n    \\\"vim.autoSwitchInputMethod.enable\\\": true,\\n    \\\"vim.autoSwitchInputMethod.defaultIM\\\": \\\"1\\\",\\n    \\\"vim.autoSwitchInputMethod.obtain